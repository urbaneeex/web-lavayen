---
import { SOCIAL_PROFILE_URLS } from '../site';

const [instagramHref, linkedInHref] = SOCIAL_PROFILE_URLS;

/**
 * Pie global — réplica del footer Framer (3 columnas + marca).
 */
interface Props {
	variant?: 'standalone' | 'in-content';
}

const { variant = 'standalone' } = Astro.props;

const pages = [
	{ href: '/', label: 'Home' },
	{ href: '/works', label: 'Work' },
	{ href: '/fotos', label: 'Fotos' },
	{ href: '/contacto', label: 'Contacto' },
	{ href: '/404', label: '404' }
] as const;

const socials = [
	{ href: instagramHref, label: 'Instagram', external: true },
	{ href: linkedInHref, label: 'LinkedIn', external: true }
] as const;
---

<footer class:list={['site-footer', variant === 'in-content' && 'site-footer--in-content']}>
	<div class="site-footer__max">
	<div class="site-footer__links">
		<div class="site-footer__col">
			<p class="site-footer__label">Pages</p>
			{
				pages.map((item) => (
					<a class="footer-link" href={item.href}>
						<span class="footer-link__clip">
							<span class="footer-link__stack">
								<span class="footer-link__line">{item.label}</span>
								<span class="footer-link__line" aria-hidden="true">
									{item.label}
								</span>
							</span>
						</span>
					</a>
				))
			}
		</div>
		<div class="site-footer__col">
			<p class="site-footer__label">Socials</p>
			{
				socials.map((item) => (
					<a class="footer-link" href={item.href} target="_blank" rel="noreferrer noopener">
						<span class="footer-link__clip">
							<span class="footer-link__stack">
								<span class="footer-link__line">{item.label}</span>
								<span class="footer-link__line" aria-hidden="true">
									{item.label}
								</span>
							</span>
						</span>
					</a>
				))
			}
		</div>
		<div class="site-footer__col site-footer__col--info">
			<p class="site-footer__label">Info</p>
			<a class="footer-link footer-link--terms" href="/legal/therms" target="_blank" rel="noreferrer noopener">
				<span class="footer-link__clip">
					<span class="footer-link__stack">
						<span class="footer-link__line">Términos y condiciones</span>
						<span class="footer-link__line" aria-hidden="true">Términos y condiciones</span>
					</span>
				</span>
			</a>
			<button type="button" class="footer-link footer-cookie-btn" data-open-cookies>
				<span class="footer-link__clip">
					<span class="footer-link__stack">
						<span class="footer-link__line">
							<span class="cookie-full">Configurar Cookies</span>
							<span class="cookie-short">Cookies</span>
						</span>
						<span class="footer-link__line" aria-hidden="true">
							<span class="cookie-full">Configurar Cookies</span>
							<span class="cookie-short">Cookies</span>
						</span>
					</span>
				</span>
			</button>
		</div>
	</div>
	<div class="site-footer__rule" aria-hidden="true"></div>
	<div class="site-footer__bar">
		<h2 class="footer-brand">Ángel Lavayen</h2>
		<p class="footer-copy">© 2026 Ángel Lavayen. All rights reserved.</p>
	</div>
	</div>
</footer>

<style>
	.site-footer,
	.site-footer * {
		box-sizing: border-box;
	}

	/*
	 * «Footer reveal» (réplica Framer): el pie queda pegado al fondo del viewport
	 * (sticky, z-index 0) y el contenido de la página, opaco y por encima (z-index 1),
	 * se desliza sobre él hasta destaparlo al final del scroll.
	 */
	.site-footer {
		width: 100%;
		max-width: 100%;
		margin-top: auto;
		background: #000;
		color: #fff;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		position: sticky;
		bottom: 0;
		z-index: 0;
		overflow-x: clip;
	}

	/* Contenido de página (hijos directos del body) que pasa por encima del pie */
	:global(body > main),
	:global(body > section) {
		position: relative;
		z-index: 1;
	}

	/* Fondo opaco por defecto (especificidad 0: cualquier regla de página lo sobreescribe) */
	:global(:where(body > main, body > section)) {
		background-color: #000;
	}

	.site-footer__max {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 30px;
	}

	.site-footer--in-content {
		margin-top: 0;
	}

	.site-footer__links {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		width: 100%;
		padding: 30px 0;
	}

	.site-footer__col {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		padding: 0 40px 0 0;
	}

	.site-footer__label {
		margin: 0;
		width: 100%;
		font-family: 'Inter Display', sans-serif;
		font-size: 16px;
		font-weight: 400;
		line-height: 19.2px;
		color: rgba(245, 245, 245, 0.4);
	}

	.footer-link {
		display: block;
		min-width: 0;
		max-width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		color: #fff;
		text-decoration: none;
		text-align: left;
		cursor: pointer;
		font: inherit;
	}

	.footer-link__clip {
		display: block;
		overflow: hidden;
		height: 19.2px;
	}

	.footer-link__stack {
		display: flex;
		flex-direction: column;
		transition: transform 0.45s cubic-bezier(0.33, 1, 0.68, 1);
	}

	.footer-link__line {
		display: block;
		font-family: 'Inter Display', sans-serif;
		font-size: 16px;
		font-weight: 400;
		line-height: 19.2px;
		color: #fff;
		white-space: nowrap;
	}

	.cookie-short {
		display: none;
	}

	.footer-link:hover .footer-link__stack,
	.footer-link:focus-visible .footer-link__stack {
		transform: translateY(-50%);
	}

	.footer-link:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.65);
		outline-offset: 3px;
	}

	.site-footer__rule {
		width: 100%;
		height: 1px;
		background: rgb(34, 34, 37);
	}

	.site-footer__bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 20px 0;
	}

	.footer-brand {
		margin: 0;
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: 28px;
		font-weight: 400;
		line-height: 33.6px;
		color: #fff;
	}

	.footer-copy {
		margin: 0;
		font-family: 'Inter Display', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 14px;
		color: rgba(255, 255, 255, 0.7);
		white-space: nowrap;
	}

	@media (max-width: 1199px) {
		.site-footer__label,
		.footer-link__line {
			font-size: 15px;
			line-height: 18px;
		}

		.footer-link__clip {
			height: 18px;
		}

		.footer-brand {
			font-size: 26.25px;
			line-height: 31.5px;
		}
	}

	@media (max-width: 809px) {
		.site-footer__max {
			padding: 0 15px;
		}

		.site-footer__label,
		.footer-link__line {
			font-size: 14px;
			line-height: 16.8px;
		}

		.footer-link__clip {
			height: 16.8px;
		}

		.site-footer__bar {
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-start;
			gap: 5px;
		}

		.footer-brand {
			font-size: 24.5px;
			line-height: 29.4px;
		}

		.footer-copy {
			white-space: normal;
		}

		.site-footer__col--info {
			overflow: clip;
			padding-right: 20px;
		}

		.footer-link--terms .footer-link__line {
			white-space: pre-wrap;
			overflow-wrap: anywhere;
		}

		.footer-link--terms .footer-link__clip {
			height: auto;
		}

		.footer-link--terms .footer-link__line[aria-hidden='true'] {
			display: none;
		}

		.cookie-full {
			display: none;
		}

		.cookie-short {
			display: inline;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-link__stack {
			transition: none;
		}

		.footer-link:hover .footer-link__stack,
		.footer-link:focus-visible .footer-link__stack {
			transform: none;
		}
	}
</style>

<script is:inline>
	document.addEventListener('click', function (e) {
		var t = e.target;
		if (!t || !t.closest) return;
		if (t.closest('[data-open-cookies]')) {
			e.preventDefault();
			window.dispatchEvent(new CustomEvent('lavayen-open-cookies'));
		}
	});
</script>
