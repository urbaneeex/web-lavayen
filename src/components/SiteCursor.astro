---
/**
 * Cursor custom — réplica del componente Framer «Cursor»
 * (shared-lib, variantes Regular / View / Go / Button + pressed).
 *
 * Regular: 20×20, blanco, mix-blend-mode: difference
 * View:    29×40 + píldora «Ver» (fichas de trabajo)
 * Go:      29×29 + píldora «Ir» (enlaces externos)
 * Button:  35×29 (nav, footer, CTA)
 * Pressed: 16×16 (Regular) / 28×28 (Button) — View/Go no tienen pressed
 * Spring:  stiffness 500 / damping 60 / mass 1
 *
 * El blend va en ESTE elemento (cápsula + píldora): un padre con
 * z-index / opacity / transform aísla mix-blend-mode y el círculo
 * se queda blanco sobre cualquier fondo.
 */
interface Props {
	/** Selectores que activan la variante Button (Framer: data-framer-cursor = 1u29ztf) */
	hoverSelector: string;
	/** Selectores de la variante View («Ver») */
	viewSelector?: string;
	/** Selectores de la variante Go («Ir») */
	goSelector?: string;
}

const { hoverSelector, viewSelector = '', goSelector = '' } = Astro.props;
---

<span id="cursor-dot" class="cursor-dot" aria-hidden="true">
	<span class="cursor-dot__label cursor-dot__view">Ver</span>
	<span class="cursor-dot__label cursor-dot__go">Ir</span>
</span>

<script define:vars={{ hoverSelector, viewSelector, goSelector }}>
	const cursor = document.getElementById('cursor-dot');
	const noHover = window.matchMedia('(any-hover: none)');
	if (cursor) {
		var inited = false;
		var pressed = false;

		var hits = (el, sel) => Boolean(sel && el && el.closest && el.closest(sel));

		var applyFromPoint = (x, y) => {
			var el = document.elementFromPoint(x, y);
			var onView = hits(el, viewSelector);
			var onGo = !onView && hits(el, goSelector);
			var onButton = !onView && !onGo && hits(el, hoverSelector);
			cursor.classList.toggle('is-view', onView);
			cursor.classList.toggle('is-go', onGo);
			cursor.classList.toggle('is-button', onButton);
			cursor.classList.toggle('is-pressed', pressed && !onView && !onGo);
		};

		var hide = function () {
			cursor.classList.remove('is-active', 'is-button', 'is-view', 'is-go', 'is-pressed');
			pressed = false;
		};

		var init = function () {
			if (inited || noHover.matches) return;
			inited = true;
			document.documentElement.classList.add('has-custom-cursor');

			var onMove = (event) => {
				if (event.pointerType === 'touch') return;
				cursor.style.left = event.clientX + 'px';
				cursor.style.top = event.clientY + 'px';
				cursor.classList.add('is-active');
				applyFromPoint(event.clientX, event.clientY);
			};

			var onDown = (event) => {
				if (event.pointerType === 'touch') return;
				pressed = true;
				applyFromPoint(event.clientX, event.clientY);
			};

			var onUp = (event) => {
				pressed = false;
				applyFromPoint(event.clientX, event.clientY);
			};

			window.addEventListener('pointermove', onMove, { passive: true });
			window.addEventListener('pointerdown', onDown, { passive: true });
			window.addEventListener('pointerup', onUp, { passive: true });
			window.addEventListener('pointercancel', onUp, { passive: true });
			document.documentElement.addEventListener('mouseleave', hide);
			window.addEventListener('blur', hide);
		};

		if (!noHover.matches) init();
		noHover.addEventListener('change', function () {
			if (!noHover.matches) init();
		});
	}
</script>

<style is:global>
	@media (hover: hover) and (pointer: fine) {
		html.has-custom-cursor,
		html.has-custom-cursor * {
			cursor: none !important;
		}
	}

	.cursor-dot {
		position: fixed;
		top: 0;
		left: 0;
		width: 20px;
		height: 20px;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 200px;
		background-color: #fff;
		mix-blend-mode: difference;
		overflow: visible;
		pointer-events: none;
		z-index: 2147483001;
		opacity: 0;
		transform: translate(-50%, -50%);
		transform-origin: center;
		will-change: auto;
		isolation: auto;
		/* spring 500 / 60 / 1 (overdamped) + fade Framer 0.2s */
		transition:
			opacity 0.2s linear,
			width 280ms cubic-bezier(0.22, 1, 0.36, 1),
			height 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.cursor-dot.is-active {
		opacity: 1;
	}

	.cursor-dot.is-button {
		width: 35px;
		height: 29px;
	}

	.cursor-dot.is-view {
		width: 29px;
		height: 40px;
	}

	.cursor-dot.is-go {
		width: 29px;
		height: 29px;
	}

	.cursor-dot.is-pressed {
		width: 16px;
		height: 16px;
	}

	.cursor-dot.is-button.is-pressed {
		width: 28px;
		height: 28px;
	}

	.cursor-dot__label {
		position: absolute;
		left: 20px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 5px 12px;
		border-radius: 19px;
		background-color: #fff;
		color: #000;
		font-family: 'Inter Display', Inter, system-ui, sans-serif;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: 0;
		text-align: center;
		white-space: pre;
		opacity: 0;
		pointer-events: none;
		z-index: 1;
		transition:
			opacity 280ms cubic-bezier(0.22, 1, 0.36, 1),
			left 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.cursor-dot.is-view .cursor-dot__view,
	.cursor-dot.is-go .cursor-dot__go {
		opacity: 1;
		left: 35px;
		top: 52%;
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor-dot,
		.cursor-dot__label {
			transition: none;
		}
	}

	@media (any-hover: none) {
		.cursor-dot {
			display: none !important;
		}
	}
</style>
