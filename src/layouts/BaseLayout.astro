---
import CookieBanner from '../components/CookieBanner.astro';
import SiteCursor from '../components/SiteCursor.astro';
import { SITE_ORIGIN } from '../site';

interface Props {
	title: string;
	description: string;
	/** Si no se pasa, se calcula con SITE_ORIGIN + pathname actual */
	canonicalURL?: string;
	robots?: string;
	lang?: string;
	ogType?: 'website' | 'article';
	ogSiteName?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogUrl?: string;
	ogImage?: string | undefined;
	/** Dimensiones OG cuando se conocen (mejor para redes sociales). */
	ogImageWidth?: number;
	ogImageHeight?: number;
	/** og:locale (p. ej. en_US en /en/). */
	ogLocale?: string;
	/** Idioma alternativo del sitio (og:locale:alternate). */
	ogLocaleAlternate?: string;
	twitterCard?: 'summary' | 'summary_large_image';
	keywords?: string;
	author?: string;
	showTwitter?: boolean;
	showOgSiteName?: boolean;
	showCursor?: boolean;
	/** Variante Button del cursor Framer (nav, footer, CTA). */
	cursorHoverSelector?: string;
	/** Variante View («Ver») — fichas de trabajo. */
	cursorViewSelector?: string;
	/** Variante Go («Ir») — enlaces externos (pósters / Gumroad). */
	cursorGoSelector?: string;
}

const {
	title,
	description,
	canonicalURL: canonicalURLProp,
	robots = 'index, follow',
	lang = 'es',
	ogType = 'website',
	ogSiteName = 'Ángel Lavayen',
	ogTitle,
	ogDescription,
	ogUrl,
	ogImage,
	ogImageWidth,
	ogImageHeight,
	ogLocale = 'es_ES',
	ogLocaleAlternate,
	twitterCard = 'summary_large_image',
	keywords,
	author,
	showTwitter = true,
	showOgSiteName = true,
	showCursor = true,
	cursorHoverSelector = '.site-header a, .site-header button, .nav-mobile a, .nav-mobile button, .site-footer a, .site-footer button, .cta-btn, .cookie-banner button, .contact-value',
	cursorViewSelector = '.work-item-link',
	cursorGoSelector = '.poster-print'
} = Astro.props;

const canonicalURL = canonicalURLProp ?? new URL(Astro.url.pathname, SITE_ORIGIN).toString();
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
const resolvedOgUrl = ogUrl ?? canonicalURL;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords ? <meta name="keywords" content={keywords} /> : null}
		{author ? <meta name="author" content={author} /> : null}
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content={ogLocale} />
		{ogLocaleAlternate ? <meta property="og:locale:alternate" content={ogLocaleAlternate} /> : null}
		{showOgSiteName ? <meta property="og:site_name" content={ogSiteName} /> : null}
		<meta property="og:title" content={resolvedOgTitle} />
		<meta property="og:description" content={resolvedOgDesc} />
		<meta property="og:url" content={resolvedOgUrl} />
		{
			ogImage ? (
				<>
					<meta property="og:image" content={ogImage} />
					{ogImageWidth && ogImageHeight ? (
						<>
							<meta property="og:image:width" content={String(ogImageWidth)} />
							<meta property="og:image:height" content={String(ogImageHeight)} />
						</>
					) : null}
				</>
			) : null
		}

		{
			showTwitter ? (
				<>
					<meta name="twitter:card" content={twitterCard} />
					<meta name="twitter:title" content={resolvedOgTitle} />
					<meta name="twitter:description" content={resolvedOgDesc} />
					{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
				</>
			) : null
		}

		<link
			rel="preload"
			href="/fonts/instrument-serif-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/inter-display-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<style is:global>
			@font-face {
				font-family: 'Instrument Serif';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/instrument-serif-400-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
					U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Instrument Serif';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/instrument-serif-400-latinext.woff2') format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329,
					U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			@font-face {
				font-family: 'Instrument Serif';
				font-style: italic;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/instrument-serif-400italic-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
					U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Instrument Serif';
				font-style: italic;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/instrument-serif-400italic-latinext.woff2') format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329,
					U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			@font-face {
				font-family: 'Inter Display';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/inter-display-400-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F,
					U+2070, U+2074-207E, U+2080-208E, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Inter Display';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/inter-display-400-latinext.woff2') format('woff2');
				unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F,
					U+A720-A7FF;
			}
			@font-face {
				font-family: 'Inter Display';
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url('/fonts/inter-display-500-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F,
					U+2070, U+2074-207E, U+2080-208E, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Inter Display';
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url('/fonts/inter-display-500-latinext.woff2') format('woff2');
				unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F,
					U+A720-A7FF;
			}

			/* Misma escala que Framer: 15px en tablet, 14px en móvil. */
			@media (min-width: 810px) and (max-width: 1199.98px) {
				:root {
					font-size: 93.75%;
				}
			}

			@media (max-width: 809.98px) {
				:root {
					font-size: 87.5%;
				}
			}
		</style>

		<slot name="head" />
	</head>
	<body>
		<slot />
		<CookieBanner />
		{showCursor ? (
			<SiteCursor
				hoverSelector={cursorHoverSelector}
				viewSelector={cursorViewSelector}
				goSelector={cursorGoSelector}
			/>
		) : null}
	</body>
</html>
