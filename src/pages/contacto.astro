---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	OG_IMAGE_DEFAULT_HEIGHT,
	OG_IMAGE_DEFAULT_URL,
	OG_IMAGE_DEFAULT_WIDTH,
	PERSON_LEGAL_NAME,
	SITE_ORIGIN
} from '../site';

const title = 'Contacto | Ángel Lavayen — Diseño gráfico y dirección de arte en Madrid';
const description =
	'Teléfono, email y ubicación en Madrid para contratar a Ángel Alejandro Lavayen Ruiz: dirección de arte, diseño gráfico, motion graphics y vídeo.';
const canonicalURL = new URL(Astro.url.pathname, SITE_ORIGIN).toString();
---

<BaseLayout
	title={title}
	description={description}
	canonicalURL={canonicalURL}
	ogImage={OG_IMAGE_DEFAULT_URL}
	ogImageWidth={OG_IMAGE_DEFAULT_WIDTH}
	ogImageHeight={OG_IMAGE_DEFAULT_HEIGHT}
	ogLocaleAlternate="en_US"
>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ContactPage',
			name: 'Contacto — Ángel Lavayen',
			description,
			url: canonicalURL,
			mainEntity: {
				'@type': 'Person',
				name: PERSON_LEGAL_NAME,
				email: 'angel@lavayen.me',
				telephone: '+34608812834',
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Madrid',
					addressCountry: 'ES'
				}
			}
		})}
	/>

	<style slot="head">
		* {
			box-sizing: border-box;
		}

		html,
		body {
			margin: 0;
			padding: 0;
			font-family: 'Inter Display', Inter, system-ui, sans-serif;
			background: #000;
			color: #fff;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		body {
			cursor: none;
			min-height: 100svh;
			display: flex;
			flex-direction: column;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.contact-page {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 100%;
			background: #000;
		}

		.contact {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 100%;
			max-width: 1440px;
			padding: 84px 30px 0;
		}

		.contact-inner {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: flex-start;
			gap: 50px;
			width: 100%;
			padding: 30px 0;
			overflow: hidden;
			border-top: 1px solid rgb(34, 34, 37);
		}

		.contact-copy {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			min-width: 0;
		}

		.contact-copy h1 {
			margin: 0 0 10px;
			font-family: 'Instrument Serif', Georgia, serif;
			font-size: 40px;
			font-weight: 400;
			line-height: 1.2;
			color: #fff;
		}

		.contact-emoji {
			font-family: 'Inter Display', sans-serif;
			font-size: 30.4px;
			font-weight: 400;
			line-height: 1.2;
			font-style: normal;
		}

		.contact-lead {
			margin: 0;
			font-family: 'Inter Display', sans-serif;
			font-size: 16px;
			font-weight: 400;
			line-height: 1.4;
			color: rgba(255, 255, 255, 0.4);
		}

		.contact-fields {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 30px;
			min-width: 0;
		}

		.contact-block {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			gap: 5px;
			min-width: 0;
			overflow: hidden;
		}

		.contact-label,
		.contact-value {
			margin: 0;
			font-family: 'Inter Display', sans-serif;
			font-size: 16px;
			font-weight: 400;
			line-height: 1.4;
		}

		.contact-label {
			color: #fff;
		}

		.contact-value {
			color: rgba(255, 255, 255, 0.7);
		}

		a.contact-value:hover {
			color: #fff;
		}

		.contact-appear {
			opacity: 0.001;
			filter: blur(5px);
			transform: translateY(15px);
		}

		.contact-appear.is-in {
			animation: contact-appear 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			animation-delay: var(--appear-delay, 0ms);
		}

		@keyframes contact-appear {
			to {
				opacity: 1;
				filter: blur(0);
				transform: translateY(0);
			}
		}

		/* Tablet (<1200) */
		@media (max-width: 1199px) {
			.contact-copy h1 {
				font-size: 37.5px;
			}

			.contact-emoji {
				font-size: 28.5px;
			}

			.contact-lead,
			.contact-label,
			.contact-value {
				font-size: 15px;
			}
		}

		/* Móvil (<810) */
		@media (max-width: 809px) {
			.contact {
				padding: 60px 15px 20px;
			}

			.contact-inner {
				display: flex;
				flex-direction: column;
				align-items: stretch;
				gap: 60px;
				padding: 20px 0 40px;
			}

			.contact-fields {
				width: 100%;
			}

			.contact-copy h1 {
				font-size: 35px;
			}

			.contact-emoji {
				font-size: 26.6px;
			}

			.contact-lead,
			.contact-label,
			.contact-value {
				font-size: 14px;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			html {
				scroll-behavior: auto;
			}

			.contact-appear,
			.contact-appear.is-in {
				opacity: 1;
				filter: none;
				transform: none;
				animation: none !important;
			}
		}

		@media (hover: none), (pointer: coarse) {
			body {
				cursor: auto;
			}
		}
	</style>

	<Header theme="hero" />

	<main class="contact-page" id="main">
		<section class="contact" aria-label="Contacto">
			<div class="contact-inner">
				<div class="contact-copy">
					<h1 class="contact-appear" style="--appear-delay: 0ms">
						Venga, no muerde. <span class="contact-emoji">📨</span>
					</h1>
					<p class="contact-lead contact-appear" style="--appear-delay: 80ms">
						Si has llegado hasta aquí es que algo te ha cuadrado. Escríbeme, llámame, mándame un mensaje con
						el emoji que más te guste, el que más odies o incluso uno vacío – lo que sea. Intento contestar
						antes de que te arrepientas.
					</p>
				</div>
				<div class="contact-fields contact-appear" style="--appear-delay: 120ms">
					<div class="contact-block">
						<p class="contact-label">Teléfono</p>
						<a class="contact-value" href="tel:+34608812834">+34 608 812 834</a>
					</div>
					<div class="contact-block">
						<p class="contact-label">Direccion</p>
						<p class="contact-value">Madrid, España</p>
					</div>
					<div class="contact-block">
						<p class="contact-label">Email</p>
						<a class="contact-value" href="mailto:angel@lavayen.me">angel@lavayen.me</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<script>
		const parts = document.querySelectorAll<HTMLElement>('.contact-appear');
		parts.forEach((el) => el.classList.add('is-in'));
	</script>
</BaseLayout>
