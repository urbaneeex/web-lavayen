---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroGodRays from '../components/HeroGodRays.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_ORIGIN } from '../site';

const title = 'Fotografía y mirada creativa | Ángel Lavayen, Madrid';
const description =
	'Galería personal en blanco y negro de Ángel Alejandro Lavayen Ruiz: fotografía, composición y ojo de director de arte en Madrid.';
const canonicalURL = new URL(Astro.url.pathname, SITE_ORIGIN).toString();
const heroImg = '/images/foto-barco.webp';
const ogImage = new URL(heroImg, SITE_ORIGIN).href;

const heroWords = ['Fotos', 'que', 'nadie', 'me', 'pidió', 'hacer…'] as const;

const ctaWords: { text: string; italic?: boolean; breakAfter?: boolean }[] = [
	{ text: 'Esto' },
	{ text: 'no' },
	{ text: 'es' },
	{ text: 'TikTok,' },
	{ text: 'así' },
	{ text: 'que' },
	{ text: 'no' },
	{ text: 'scrollees', italic: true },
	{ text: 'más', breakAfter: true },
	{ text: 'y' },
	{ text: 'contacta' },
	{ text: 'conmigo' },
	{ text: '🤩' }
];

const fotos = [
	{ src: '/images/foto-01.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (1 de 14)' },
	{ src: '/images/foto-02.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (2 de 14)' },
	{ src: '/images/foto-03.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (3 de 14)' },
	{ src: '/images/foto-04.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (4 de 14)' },
	{ src: '/images/foto-05.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (5 de 14)' },
	{ src: '/images/foto-06.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (6 de 14)' },
	{ src: '/images/foto-07.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (7 de 14)' },
	{ src: '/images/foto-08.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (8 de 14)' },
	{ src: '/images/foto-09.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (9 de 14)' },
	{ src: '/images/foto-10.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (10 de 14)' },
	{ src: '/images/foto-11.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (11 de 14)' },
	{ src: '/images/foto-12.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (12 de 14)' },
	{ src: '/images/foto-13.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (13 de 14)' },
	{ src: '/images/foto-14.webp', alt: 'Fotografía en blanco y negro — galería personal de Ángel Lavayen (14 de 14)' }
];
---

<BaseLayout
	title={title}
	description={description}
	canonicalURL={canonicalURL}
	ogImage={ogImage}
	ogImageWidth={3587}
	ogImageHeight={2018}
	ogLocaleAlternate="en_US"
>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'CollectionPage',
			name: 'Fotos — Ángel Lavayen',
			description,
			url: canonicalURL,
			isPartOf: { '@type': 'WebSite', name: 'Ángel Lavayen', url: `${SITE_ORIGIN}/` }
		})}
	/>

	<style slot="head">
		* {
			box-sizing: border-box;
		}

		html,
		body {
			margin: 0;
			padding: 0;
			font-family: 'Inter Display', Inter, system-ui, sans-serif;
			background: #000;
			color: #f5f5f5;
		}

		body {
			cursor: none;
			min-height: 100svh;
			display: flex;
			flex-direction: column;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.fotos-page {
			flex: 1;
			width: 100%;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		/* —— Hero (Framer Hero 1: 100vh, título difference) —— */
		.fotos-hero {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100vh;
			overflow: hidden;
			background: #000;
		}

		.fotos-hero__image {
			position: absolute;
			inset: 0;
			overflow: hidden;
		}

		.fotos-hero__image img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center;
		}

		.fotos-hero::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				to top,
				#000 0%,
				rgba(0, 0, 0, 0.65) 10%,
				transparent 22%
			);
			z-index: 1;
		}

		.fotos-hero__copy {
			position: relative;
			z-index: 2;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			gap: 5px;
			width: 100%;
			max-width: 1440px;
			padding: 0 30px 0 80px;
			mix-blend-mode: difference;
		}

		.fotos-hero h1 {
			margin: 0;
			font-family: 'Instrument Serif', Georgia, serif;
			font-size: 41.6px;
			font-weight: 400;
			line-height: 49.92px;
			text-align: left;
			color: #fff;
		}

		.fotos-word {
			display: inline-block;
		}

		.fotos-appear {
			opacity: 0.001;
			filter: blur(5px);
			transform: translateY(15px);
		}

		.fotos-appear.is-in {
			animation: fotos-appear 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			animation-delay: var(--appear-delay, 0ms);
		}

		/* CTA: blur 5px + sube 15px, palabra a palabra. Spring 800/120, espera 0.1s y 0.15s entre palabras. */
		.fotos-cta.is-in .fotos-appear {
			animation: fotos-appear 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			animation-delay: var(--appear-delay, 0.1s);
		}

		@keyframes fotos-appear {
			to {
				opacity: 1;
				filter: blur(0);
				transform: translateY(0);
			}
		}

		/* —— Intro (Framer Introduction) —— */
		.fotos-intro {
			display: flex;
			align-items: flex-start;
			justify-content: center;
			width: 100%;
			max-width: 1440px;
			padding: 100px 30px;
			overflow: hidden;
		}

		.fotos-intro p {
			margin: 0;
			width: 100%;
			max-width: 966px;
			font-family: 'Inter Display', sans-serif;
			font-size: 16px;
			font-weight: 400;
			line-height: 22.4px;
			text-align: center;
			color: #fff;
		}

		/* —— Galería (Framer: 1035/1440 ≈ 71.875%, 2 col, 16:9, gap 6) —— */
		.fotos-grid {
			width: 71.875%;
			margin: 30px auto 0;
			overflow: hidden;
		}

		.photo-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 6px;
			width: 100%;
		}

		.photo {
			position: relative;
			display: block;
			aspect-ratio: 16 / 9;
			overflow: hidden;
			background: #000;
		}

		.photo img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* —— CTA (Framer Collaborate + God Rays + Vale) —— */
		.fotos-cta-wrap {
			width: 100%;
			max-width: 1440px;
			margin-top: 30px;
			padding: 60px 30px 0;
		}

		.fotos-cta {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 580px;
			padding: 40px 0 0;
			margin: 0 0 60px;
			background: #000;
			overflow: hidden;
		}

		.fotos-cta__rays {
			position: absolute;
			left: 0;
			right: 0;
			top: 40px;
			bottom: 0;
			z-index: 0;
			overflow: hidden;
			pointer-events: none;
		}

		.fotos-cta__pad {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			gap: 15px;
			width: 100%;
			max-width: 1440px;
			padding: 0 30px;
		}

		.fotos-cta__copy {
			margin: 0;
			width: 60%;
			font-family: 'Instrument Serif', Georgia, serif;
			font-size: 41.6px;
			font-weight: 400;
			font-feature-settings: 'blwf' on, 'cv09' on, 'cv03' on, 'cv04' on, 'cv11' on;
			line-height: 1.2;
			text-align: left;
			color: #fff;
			white-space: pre-wrap;
			word-break: break-word;
			position: relative;
			z-index: 1;
			mix-blend-mode: overlay;
		}

		.cta-break {
			display: block;
		}

		.fotos-cta__copy .fotos-word {
			display: inline-block;
		}

		.fotos-cta__copy em {
			font-style: italic;
		}

		.cta-btn {
			position: relative;
			z-index: 1;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 5px;
			padding: 10px 24px;
			background: #000;
			overflow: hidden;
			text-decoration: none;
			color: #fff;
		}

		.cta-btn__fill {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 0;
			background: #fff;
			z-index: 1;
			transition: height 0.45s cubic-bezier(0.33, 1, 0.68, 1);
		}

		.cta-btn__clip {
			position: relative;
			z-index: 2;
			display: block;
			overflow: hidden;
			height: 19.2px;
		}

		.cta-btn__stack {
			display: flex;
			flex-direction: column;
			transition: transform 0.45s cubic-bezier(0.33, 1, 0.68, 1);
		}

		.cta-btn__line {
			display: block;
			font-family: 'Inter Display', sans-serif;
			font-size: 16px;
			font-weight: 500;
			line-height: 19.2px;
			white-space: nowrap;
		}

		.cta-btn__line--on {
			color: #fff;
		}

		.cta-btn__line--off {
			color: #000;
		}

		.cta-btn:hover .cta-btn__fill,
		.cta-btn:focus-visible .cta-btn__fill {
			height: 100%;
		}

		.cta-btn:hover .cta-btn__stack,
		.cta-btn:focus-visible .cta-btn__stack {
			transform: translateY(-50%);
		}

		.cta-btn:focus-visible {
			outline: 2px solid rgba(255, 255, 255, 0.65);
			outline-offset: 3px;
		}

		/* Tablet (<1200) */
		@media (max-width: 1199px) {
			.fotos-hero h1 {
				font-size: 39px;
				line-height: 46.8px;
			}

			.fotos-intro {
				padding: 20px 30px;
			}

			.fotos-intro p {
				max-width: none;
				font-size: 15px;
				line-height: 21px;
			}

			.fotos-grid {
				width: 100%;
				max-width: none;
				padding: 0 30px;
			}

			.photo-grid {
				grid-template-columns: 1fr;
			}

			.fotos-cta__copy {
				width: 70%;
				font-size: 39px;
			}

			.cta-break {
				display: none;
			}

			.cta-btn__clip {
				height: 18px;
			}

			.cta-btn__line {
				font-size: 15px;
				line-height: 18px;
			}
		}

		/* Móvil (<810) */
		@media (max-width: 809px) {
			.fotos-hero {
				height: 100vh;
				padding-bottom: 250px;
			}

			.fotos-hero__copy {
				padding: 0 15px;
			}

			.fotos-hero h1 {
				font-size: 36.4px;
				line-height: 43.68px;
			}

			.fotos-intro {
				min-height: 50vh;
				align-items: center;
				padding: 20px 15px;
			}

			.fotos-intro p {
				font-size: 14px;
				line-height: 19.6px;
			}

			.fotos-grid {
				padding: 0 15px;
			}

			.fotos-cta-wrap {
				padding: 40px 15px 0;
			}

			.fotos-cta {
				height: 675px;
				margin-bottom: 40px;
			}

			.fotos-cta__pad {
				padding: 0 15px;
			}

			.fotos-cta__copy {
				width: 100%;
				font-size: 36.4px;
			}

			.cta-break {
				display: block;
			}

			.cta-btn__clip {
				height: 16.8px;
			}

			.cta-btn__line {
				font-size: 14px;
				line-height: 16.8px;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.fotos-appear,
			.fotos-appear.is-in {
				opacity: 1;
				filter: none;
				transform: none;
				animation: none !important;
			}

			.cta-btn__fill,
			.cta-btn__stack {
				transition: none !important;
			}

			html {
				scroll-behavior: auto;
			}
		}

		@media (hover: none), (pointer: coarse) {
			body {
				cursor: auto;
			}
		}
	</style>

	<Header theme="hero" />

	<main class="fotos-page" id="main">
		<section class="fotos-hero" aria-label="Fotos">
			<div class="fotos-hero__image">
				<img
					src={heroImg}
					alt="Fotografía en blanco y negro de un barco — imagen principal de la galería de Ángel Lavayen"
					width="3587"
					height="2018"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
			<div class="fotos-hero__copy">
				<h1>
					{
						heroWords.map((word, i) => (
							<>
								{i > 0 ? ' ' : null}
								<span class="fotos-word fotos-appear" style={`--appear-delay: ${i * 50}ms`}>{word}</span>
							</>
						))
					}
				</h1>
			</div>
		</section>

		<section class="fotos-intro" aria-label="Introducción">
			<p>
				Este es probablemente el proyecto más inútil que tengo, pero es de los que más me gusta. Es el problema
				de un aficionado con cámara.. ¡Espero que te gusten!
			</p>
		</section>

		<section class="fotos-grid" aria-label="Galería de fotografías">
			<div class="photo-grid">
				{
					fotos.map((f) => (
						<div class="photo" aria-label={f.alt}>
							<img src={f.src} alt={f.alt} width="1600" height="900" loading="lazy" decoding="async" />
						</div>
					))
				}
			</div>
		</section>

		<section class="fotos-cta-wrap" aria-label="Contacto">
			<div class="fotos-cta">
				<div class="fotos-cta__rays" aria-hidden="true">
					<HeroGodRays />
				</div>
				<div class="fotos-cta__pad">
					<h2 class="fotos-cta__copy">
						{
							ctaWords.map((word, i) => (
								<>
									{i > 0 && !ctaWords[i - 1].breakAfter ? ' ' : null}
									{word.italic ? (
										<em class="fotos-word fotos-appear" style={`--appear-delay: ${100 + i * 150}ms`}>{word.text}</em>
									) : (
										<span class="fotos-word fotos-appear" style={`--appear-delay: ${100 + i * 150}ms`}>{word.text}</span>
									)}
									{word.breakAfter ? <br class="cta-break" /> : null}
								</>
							))
						}
					</h2>
					<a class="cta-btn" href="/contacto">
						<span class="cta-btn__fill" aria-hidden="true"></span>
						<span class="cta-btn__clip">
							<span class="cta-btn__stack">
								<span class="cta-btn__line cta-btn__line--on">Vale</span>
								<span class="cta-btn__line cta-btn__line--off" aria-hidden="true">Vale</span>
							</span>
						</span>
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<script>
		const heroWordsEls = document.querySelectorAll<HTMLElement>('.fotos-hero .fotos-appear');
		heroWordsEls.forEach((el) => el.classList.add('is-in'));

		const bootFotosCta = () => {
			const fotosCta = document.querySelector('.fotos-cta');
			const target = document.querySelector('.fotos-cta__pad') || fotosCta;
			if (!fotosCta || !target || fotosCta.classList.contains('is-in')) return;

			const play = () => {
				if (fotosCta.classList.contains('is-in')) return;
				fotosCta.classList.add('is-in');
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onScroll);
				io?.disconnect();
			};

			const visible = () => {
				const r = target.getBoundingClientRect();
				const vh = window.innerHeight || 0;
				return r.top < vh && r.bottom > 0;
			};

			const onScroll = () => {
				if (visible()) play();
			};

			let io: IntersectionObserver | null = null;
			if ('IntersectionObserver' in window) {
				io = new IntersectionObserver(
					(entries) => {
						if (entries.some((entry) => entry.isIntersecting)) play();
					},
					{ threshold: 0 }
				);
				io.observe(target);
			}

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll, { passive: true });
			requestAnimationFrame(onScroll);
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', bootFotosCta);
		} else {
			bootFotosCta();
		}
	</script>
</BaseLayout>
