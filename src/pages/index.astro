		<script>
			const bootCta = () => {
				const cta = document.querySelector('.cta');
				const target = document.querySelector('.cta__pad') || cta;
				if (!cta || !target || cta.classList.contains('is-in')) return;

				const play = () => {
					if (cta.classList.contains('is-in')) return;
					cta.classList.add('is-in');
					window.removeEventListener('scroll', onScroll);
					window.removeEventListener('resize', onScroll);
					io?.disconnect();
				};

				const visible = () => {
					const r = target.getBoundingClientRect();
					const vh = window.innerHeight || 0;
					return r.top < vh && r.bottom > 0;
				};

				const onScroll = () => {
					if (visible()) play();
				};

				let io: IntersectionObserver | null = null;
				if ('IntersectionObserver' in window) {
					io = new IntersectionObserver(
						(entries) => {
							if (entries.some((entry) => entry.isIntersecting)) play();
						},
						{ threshold: 0 }
					);
					io.observe(target);
				}

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				requestAnimationFrame(onScroll);
			};

			const bootScrollIn = () => {
				const nodes = [...document.querySelectorAll<HTMLElement>('.scroll-in')];
				if (!nodes.length) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					nodes.forEach((node) => node.classList.add('is-in'));
					return;
				}

				const pending = new Set(nodes);
				const reveal = (node: HTMLElement) => {
					if (!pending.has(node)) return;
					pending.delete(node);
					node.classList.add('is-in');
				};

				const ratio = (node: HTMLElement) => {
					const rect = node.getBoundingClientRect();
					const vh = window.innerHeight || 0;
					if (!rect.height || vh <= 0) return 0;
					const visible = Math.min(rect.bottom, vh) - Math.max(rect.top, 0);
					return Math.max(0, visible) / rect.height;
				};

				const scan = () => {
					pending.forEach((node) => {
						const need = Number(node.dataset.appear || '0');
						const seen = ratio(node);
						if (need <= 0 ? seen > 0 : seen >= need) reveal(node);
					});
					if (!pending.size) {
						window.removeEventListener('scroll', scan);
						window.removeEventListener('resize', scan);
					}
				};

				window.addEventListener('scroll', scan, { passive: true });
				window.addEventListener('resize', scan, { passive: true });
				scan();
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => {
					bootCta();
					bootScrollIn();
				});
			} else {
				bootCta();
				bootScrollIn();
			}
		</script>
