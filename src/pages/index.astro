---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroGodRays from '../components/HeroGodRays.astro';
import SlideFrameLink from '../components/SlideFrameLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWorkBySlug } from '../data/works';
import {
	OG_IMAGE_DEFAULT_HEIGHT,
	OG_IMAGE_DEFAULT_URL,
	OG_IMAGE_DEFAULT_WIDTH,
	PERSON_ID,
	PERSON_LEGAL_NAME,
	PERSON_SHORT_NAME,
	SITE_ORIGIN,
	SOCIAL_PROFILE_URLS,
	WEBSITE_ID
} from '../site';

const title = 'Ángel Lavayen | Director de arte, diseñador gráfico y motion designer en Madrid';
const description =
	'Portfolio de Ángel Alejandro Lavayen Ruiz en Madrid: dirección de arte, diseño gráfico, motion graphics, vídeo, branding, packaging y campañas para marcas.';
const canonicalURL = new URL(Astro.url.pathname, SITE_ORIGIN).toString();
const keywords =
	'Ángel Lavayen, Ángel Alejandro Lavayen Ruiz, director de arte Madrid, diseñador gráfico Madrid, motion graphics, motion designer, branding, packaging, diseño editorial, identidad visual, portfolio creativo';

/** Orden de la home = fuente única en data/works.ts */
const homeSlugs = [
	'la-sinfonia-del-caos',
	'motion-graphics-video',
	'campana-pizzas-goodfellas',
	'campanas-digitales',
	'womo-brand'
] as const;

const homeWorks = homeSlugs.map((slug) => {
	const p = getWorkBySlug(slug);
	if (!p) throw new Error(`Work no encontrado para home: ${slug}`);
	return p;
});

const [workA, workB, workFeatured, workC, workD] = homeWorks;
---

<BaseLayout
	title={title}
	description={description}
	canonicalURL={canonicalURL}
	robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
	keywords={keywords}
	author={PERSON_LEGAL_NAME}
	ogImage={OG_IMAGE_DEFAULT_URL}
	ogImageWidth={OG_IMAGE_DEFAULT_WIDTH}
	ogImageHeight={OG_IMAGE_DEFAULT_HEIGHT}
	ogLocaleAlternate="en_US"
>
	<link rel="alternate" hreflang="es" href={`${SITE_ORIGIN}/`} slot="head" />
	<link rel="alternate" hreflang="en" href={`${SITE_ORIGIN}/en/`} slot="head" />
	<link rel="alternate" hreflang="x-default" href={`${SITE_ORIGIN}/`} slot="head" />
	<script
		type="application/ld+json"
		slot="head"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'WebSite',
					'@id': WEBSITE_ID,
					url: `${SITE_ORIGIN}/`,
					name: 'Ángel Lavayen',
					description,
					inLanguage: 'es',
					publisher: { '@id': PERSON_ID }
				},
				{
					'@type': 'Person',
					'@id': PERSON_ID,
					name: PERSON_LEGAL_NAME,
					alternateName: [PERSON_SHORT_NAME, 'Angel Lavayen', 'Ángel Lavayen'],
					jobTitle: 'Director de arte, diseñador gráfico y motion designer',
					description,
					url: `${SITE_ORIGIN}/`,
					address: {
						'@type': 'PostalAddress',
						addressLocality: 'Madrid',
						addressCountry: 'ES'
					},
					sameAs: [...SOCIAL_PROFILE_URLS],
					knowsAbout: [
						'Dirección de arte',
						'Diseño gráfico',
						'Motion graphics',
						'Branding',
						'Diseño editorial',
						'Packaging',
						'Edición de vídeo'
					]
				}
			]
		})}
	/>
	<style slot="head">
			:root {
				--light-bg: #f6f6f4;
				--light-text: #161616;
				--muted: #5c5c5c;
				--line: #d6d6d1;
				--max: 1200px;
				--site-pad: clamp(1.8rem, 4.8vw, 3rem);
				--hero-blue: rgb(0, 55, 255);
			}

			* {
				box-sizing: border-box;
				-webkit-font-smoothing: inherit;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-family: 'Inter Display', system-ui, -apple-system, sans-serif;
				background: #000;
				color: var(--light-text);
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			body {
				cursor: none;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			/* ===== HERO (Landing Hero Framer: 14o56qm) ===== */
			.hero-screen {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: space-between;
				width: 100%;
				height: 100vh;
				padding: 0 0 100px;
				background: var(--hero-blue);
				overflow: hidden;
			}

			/* Wrapper flex .5 — 98j8sn */
			.hero-spacer {
				position: relative;
				z-index: 1;
				flex: 0.5 0 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 11px;
				width: 100%;
				max-width: 1440px;
				height: 1px;
				padding: 30px;
				mix-blend-mode: overlay;
			}

			/* Wrapper flex 3 — 1k9ej2 */
			.hero-wrap {
				position: relative;
				z-index: 1;
				flex: 3 0 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 11px;
				width: 100%;
				max-width: 1440px;
				height: 1px;
				padding: 30px;
				mix-blend-mode: overlay;
			}

			h1.hero-copy {
				margin: 0;
			}

			.hero-copy {
				position: relative;
				z-index: 1;
				flex: none;
				width: 80%;
				margin: 0;
				font-family: 'Instrument Serif', 'Instrument Serif Placeholder', Georgia, serif;
				font-feature-settings: 'blwf' on, 'cv09' on, 'cv03' on, 'cv04' on, 'cv11' on;
				font-size: 2.5rem;
				font-style: italic;
				font-weight: 400;
				line-height: 1.2;
				letter-spacing: 0;
				text-align: center;
				color: #fff;
				word-break: break-word;
				overflow-wrap: break-word;
			}

			.hero-copy .roman {
				font-style: normal;
			}

			.hero-word {
				display: inline-block;
			}

			.hero-line--mob,
			.hero-br--mob {
				display: none;
			}

			/* ajfxin — sin z-index: el overlay de los hijos tiene que ver el azul */
			.hero-note-wrap {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 5px;
				width: 100%;
				height: min-content;
				padding: 0;
			}

			/* 2rkmld: overlay aquí, el filter del appear va en el hijo */
			.hero-note {
				position: relative;
				z-index: 1;
				flex: none;
				width: 100%;
				mix-blend-mode: overlay;
			}

			.hero-note p {
				margin: 0;
				font-family: 'Inter Display', 'Inter Display Placeholder', sans-serif;
				font-size: 1rem;
				font-weight: 400;
				line-height: 1.4;
				letter-spacing: 0;
				text-align: center;
				color: #fff;
				word-break: break-word;
			}

			/* 19vd1ki */
			.hero-arrow {
				position: relative;
				z-index: 1;
				flex: none;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 34px;
				mix-blend-mode: overlay;
			}

			.hero-arrow p {
				margin: 0;
				font-family: 'Inter Display', 'Inter Display Placeholder', sans-serif;
				font-size: 1rem;
				font-weight: 400;
				line-height: 1.4;
				text-align: center;
				color: #fff;
			}

			/*
			 * Appear Framer (H_4BMvy):
			 *   título: word, startDelay .1, stagger delay .15, spring 800/120
			 *   nota/flecha: element, startDelay 3, spring 200/120
			 */
			.hero-word,
			.hero-block {
				opacity: 0.001;
				filter: blur(5px);
				transform: translateY(15px);
			}

			.hero-word {
				animation: hero-appear-word 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
				animation-delay: calc(0.1s + (var(--i, 0) * 0.15s));
			}

			.hero-block {
				animation: hero-appear-block 1.05s cubic-bezier(0.25, 1, 0.32, 1) forwards;
				animation-delay: calc(3s + (var(--i, 0) * 0.15s));
			}

			@keyframes hero-appear-word {
				to {
					opacity: 1;
					filter: none;
					transform: translateY(0);
				}
			}

			@keyframes hero-appear-block {
				to {
					opacity: 1;
					filter: none;
					transform: translateY(0);
				}
			}

			/* CTA reutiliza el mismo keyframe */
			@keyframes hero-appear {
				to {
					opacity: 1;
					filter: none;
					transform: translateY(0);
				}
			}

			.content {
				width: calc(100% - (var(--site-pad) * 2));
				margin: 0 auto;
				padding: 2.5rem 0 2.8rem;
			}

			/* Framer Splitted Hero + Max Container (1440 / 745+695) */
			.intro-split {
				scroll-margin-top: 5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 100vh;
				margin: 0;
				padding: 0;
				background: #000;
				overflow: hidden;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			.intro-split__max {
				display: flex;
				flex-direction: row;
				align-items: stretch;
				width: 100%;
				max-width: 1440px;
				height: 100%;
			}

			.intro-copy {
				flex: none;
				width: calc(50% + 25px);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-width: 0;
				height: 100%;
				padding: 50px 0 50px 50px;
				background: #000;
			}

			.intro-copy__pad {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: flex-start;
				gap: 50px;
				width: 100%;
				height: 100%;
				padding: 100px 30px 0 0;
				box-sizing: border-box;
			}

			.intro-about,
			.software {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 10px;
				width: 100%;
				max-width: 1200px;
			}

			.intro-copy h2 {
				margin: 0;
				font-family: 'Instrument Serif', Georgia, serif;
				font-size: 40px;
				font-weight: 400;
				line-height: 1;
				color: #fff;
			}

			.intro-copy h2 em {
				font-style: italic;
			}

			.intro-p {
				margin: 0;
				width: 90%;
				font-family: 'Inter Display', sans-serif;
				font-size: 16px;
				font-weight: 400;
				color: rgba(255, 255, 255, 0.4);
			}

			.intro-p--loose {
				line-height: 1.4;
			}

			.intro-p--tight {
				line-height: 1.2;
			}

			.intro-p em {
				font-style: italic;
			}

			.software h3 {
				margin: 0;
				font-family: 'Instrument Serif', Georgia, serif;
				font-size: 24px;
				font-weight: 400;
				line-height: 1;
				color: #fff;
			}

			.software p {
				margin: 0;
				width: 90%;
				font-family: 'Inter Display', sans-serif;
				font-size: 16px;
				font-weight: 400;
				line-height: 1.4;
				color: rgba(255, 255, 255, 0.4);
			}

			.intro-photo {
				flex: none;
				width: calc(50% - 25px);
				position: relative;
				min-width: 0;
				height: 100%;
				overflow: hidden;
			}

			.intro-photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				display: block;
			}

			.copy {
				display: grid;
				gap: 1rem;
				max-width: 76ch;
			}

			.copy p {
				margin: 0;
				font-size: clamp(1rem, 1.2vw, 1.08rem);
				line-height: 1.55;
				color: #2a2a2a;
			}

			.section-title {
				margin: 2.2rem 0 0.65rem;
				font-size: 0.86rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--muted);
			}

			/* Framer Selected Work: max 1440, pad 0 30px 60px, grid 675+30+675 */
			.work-showcase {
				width: 100%;
				background: #000;
				color: #fff;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			.work-showcase__max {
				width: 100%;
				max-width: 1440px;
				margin: 0 auto;
				padding: 0 30px 0;
			}

			.work-showcase__head {
				display: flex;
				flex-direction: row;
				align-items: flex-start;
				padding: 30px 0;
			}

			.work-showcase h2 {
				margin: 0;
				font-family: 'Inter Display', sans-serif;
				font-size: 30.4px;
				font-weight: 400;
				line-height: 27.36px;
				color: #fff;
			}

			.work {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 30px;
			}

			.work-item {
				display: block;
				min-width: 0;
			}

			/* Appear al scroll (Framer enter): opacity 0, y 15, spring 800/120 */
			.scroll-in {
				opacity: 0;
				transform: translateY(15px);
			}

			.scroll-in.is-in {
				animation: home-scroll-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0.1s) both;
			}

			@keyframes home-scroll-in {
				to {
					opacity: 1;
					transform: none;
				}
			}

			.work-item--featured {
				grid-column: 1 / -1;
			}

			.work-item-link {
				display: flex;
				flex-direction: column;
				align-items: stretch;
				gap: 15px;
				color: inherit;
				text-decoration: none;
				min-width: 0;
				overflow: hidden;
			}

			.work-item-link:focus-visible {
				outline: 2px solid rgba(255, 255, 255, 0.65);
				outline-offset: 3px;
			}

			.work-media {
				margin: 0;
				aspect-ratio: 1.4386 / 1;
				background: #111;
				overflow: hidden;
			}

			.work-media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.work-meta {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 10px;
				width: 100%;
			}

			.work-year {
				width: fit-content;
				padding: 5px 9px;
				font-family: 'Inter Display', sans-serif;
				font-size: 13px;
				font-weight: 400;
				line-height: 15.6px;
				color: #fff;
				background: rgb(23, 23, 23);
				border: 0;
			}

			.work-meta__titles {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: center;
				gap: 5px;
				width: 100%;
			}

			.work-item h3 {
				margin: 0;
				font-family: 'Inter Display', sans-serif;
				font-size: 22.4px;
				font-weight: 500;
				line-height: 26.88px;
				color: #fff;
			}

			.work-item p {
				margin: 0;
				font-family: 'Inter Display', sans-serif;
				font-size: 16px;
				font-weight: 400;
				line-height: 22.4px;
				color: rgba(255, 255, 255, 0.7);
			}

			.index-more-projects {
				margin-top: 60px;
				width: 100%;
				display: flex;
				justify-content: center;
			}

			.index-more-projects :global(.slide-frame-link) {
				border: 0;
				padding: 0;
				font-family: 'Inter Display', sans-serif;
				font-size: 13px;
				font-weight: 500;
				line-height: 15.6px;
				letter-spacing: 0;
			}

			/* Framer CTA: 580px, God Rays + overlay, botón fill */

			.photo-grid {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: 0.8rem;
			}

			.photo {
				border: 1px solid var(--line);
				aspect-ratio: 4 / 5;
				background: linear-gradient(145deg, #ecece8 0%, #dcdcd6 100%);
			}

			.photo:nth-child(1),
			.photo:nth-child(2),
			.photo:nth-child(3) {
				grid-column: span 4;
			}

			.cta {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 580px;
				padding: 40px 0 0;
				margin: 0;
				background: #000;
				overflow: hidden;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			.cta__rays {
				position: absolute;
				left: 0;
				right: 0;
				top: 40px;
				bottom: 0;
				z-index: 0;
				overflow: hidden;
				pointer-events: none;
			}

			.cta__pad {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: center;
				gap: 30px;
				width: 100%;
				max-width: 1440px;
				padding: 0 30px;
			}

			.cta__copy {
				position: relative;
				z-index: 1;
				margin: 0;
				width: 100%;
				max-width: 828px;
				font-family: 'Instrument Serif', Georgia, serif;
				font-size: 41.6px;
				font-weight: 400;
				line-height: 49.92px;
				text-align: left;
				color: #fff;
				mix-blend-mode: overlay;
			}

			.cta__copy .cta-word {
				display: inline-block;
			}

			.cta__copy em {
				font-style: italic;
			}

			.cta-appear {
				opacity: 0.001;
				filter: blur(5px);
				transform: translateY(15px);
			}

			.cta.is-in .cta-appear {
				animation: hero-appear 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
				animation-delay: var(--appear-delay, 0ms);
			}

			.cta-btn {
				position: relative;
				z-index: 1;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 5px;
				padding: 10px 24px;
				background: #000;
				overflow: hidden;
				text-decoration: none;
				color: #fff;
			}

			.cta-btn__fill {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 0;
				background: #fff;
				z-index: 1;
				transition: height 0.45s cubic-bezier(0.33, 1, 0.68, 1);
			}

			.cta-btn__clip {
				position: relative;
				z-index: 2;
				display: block;
				overflow: hidden;
				height: 19.2px;
			}

			.cta-btn__stack {
				display: flex;
				flex-direction: column;
				transition: transform 0.45s cubic-bezier(0.33, 1, 0.68, 1);
			}

			.cta-btn__line {
				display: block;
				font-family: 'Inter Display', sans-serif;
				font-size: 16px;
				font-weight: 500;
				line-height: 19.2px;
				white-space: nowrap;
			}

			.cta-btn__line--on {
				color: #fff;
			}

			.cta-btn__line--off {
				color: #000;
			}

			.cta-btn:hover .cta-btn__fill,
			.cta-btn:focus-visible .cta-btn__fill {
				height: 100%;
			}

			.cta-btn:hover .cta-btn__stack,
			.cta-btn:focus-visible .cta-btn__stack {
				transform: translateY(-50%);
			}

			.cta-btn:focus-visible {
				outline: 2px solid rgba(255, 255, 255, 0.65);
				outline-offset: 3px;
			}

			/* Framer: tablet 810–1199, móvil <810 */
			@media (max-width: 1199px) {
				.hero-copy {
					width: 100%;
				}

				.hero-arrow {
					height: auto;
				}
			}

			@media (max-width: 809px) {
				.hero-screen {
					padding-bottom: 80px;
				}

				.hero-spacer {
					flex: none;
					height: min-content;
					min-height: 48px;
					padding: 15px;
				}

				.hero-wrap {
					flex: none;
					height: min-content;
					padding: 15px;
				}

				.hero-copy {
					width: 100%;
				}

				.hero-line--desk {
					display: none;
				}

				.hero-line--mob {
					display: inline;
				}

				.hero-br--mob {
					display: inline;
				}

				.hero-arrow {
					height: auto;
				}
			}

			@media (max-width: 640px) {
				.photo-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.photo:nth-child(1),
				.photo:nth-child(2),
				.photo:nth-child(3) {
					grid-column: span 1;
				}
			}

			@media (max-width: 1199px) {
				.intro-copy h2 {
					font-size: 37.5px;
				}

